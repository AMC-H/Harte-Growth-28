# Cache-control voor statische assets (grote performance-win voor terugkerende bezoekers)
# Netlify past deze headers automatisch toe bovenop de build-output.

# HTML: geen lange cache, moet fresh blijven
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS + JS: 1 jaar cache (query-string voor cache-busting bij deploy)
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/analytics.js
  Cache-Control: public, max-age=3600

# SVG-logo's: 1 jaar
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# PNG's (og-images): 1 maand
/*.png
  Cache-Control: public, max-age=2592000

# Netlify Functions: 5 minuten (matches Cache-Control uit de functions zelf)
/.netlify/functions/*
  Cache-Control: public, max-age=300

# Security + privacy headers (site-breed)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
