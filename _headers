# Cache-control voor statische assets (grote performance-win voor terugkerende bezoekers)
# Netlify past deze headers automatisch toe bovenop de build-output.

# HTML: geen cache — deploys moeten meteen zichtbaar zijn
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS + JS: 1 uur cache, moet revalideren. GEEN immutable — die URL's zijn niet versioned.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
/script.js
  Cache-Control: public, max-age=3600, must-revalidate
/analytics.js
  Cache-Control: public, max-age=3600, must-revalidate

# SVG-logo's: 1 dag (veranderen zelden maar niet nooit)
/*.svg
  Cache-Control: public, max-age=86400

# PNG's (og-images): 1 week
/*.png
  Cache-Control: public, max-age=604800

# Netlify Functions: 5 minuten (matches Cache-Control uit de functions zelf)
/.netlify/functions/*
  Cache-Control: public, max-age=300

# Security + privacy headers (site-breed)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
